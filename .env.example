HOST=127.0.0.1
PORT=3000
LIVEGBS_URL=http://192.168.1.15:10000
LIVEGBS_USERNAME=admin
# 填写登录接口要求的 password 参数，后端原样传递，不进行二次转换。
LIVEGBS_PASSWORD=
LIVEGBS_TIMEOUT_MS=15000
LIVEGBS_SMS_ID=34020000002020000001
DATA_DIR=./data
# 可选：本地 ESSLD 的 Python 与源码目录，默认使用项目下已安装的环境。
ESSLD_PYTHON=./data/essld/.venv/Scripts/python.exe
ESSLD_UPSTREAM=./data/essld/upstream
MCP_HOST=0.0.0.0
MCP_PORT=3001
# 独立的 MCP 访问密钥；客户端通过 Authorization: Bearer 传入。
MCP_API_KEY=
# 可选：额外的服务主机名（不含端口），多个用逗号分隔。
MCP_ALLOWED_HOSTS=
# 可选：浏览器客户端的完整 Origin，例如 http://10.10.101.20:8080。
MCP_ALLOWED_ORIGINS=
