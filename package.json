{
  "name": "cctv-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#camera-rotation": "./shared/camera-rotation.ts"
  },
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "mcp": "node --env-file-if-exists=.env server/mcp-http.mjs",
    "mcp:stdio": "node --env-file-if-exists=.env server/mcp.mjs",
    "test": "node --test tests/*.test.mjs tests/*.test.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@fastify/static": "8.3.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "cesium": "1.147.0",
    "fastify": "5.12.8",
    "flv.js": "1.6.2",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
